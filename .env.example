# Discord webhooks — KEEP SECRET. Set these in Railway → Variables (never commit real values).
DEFAULT_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE   # catch-all "other" channel
WHALE_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE     # whale alerts (>= $5000)
SUMMARY_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE   # daily PnL leaderboard (optional)
WATCHLIST_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE # /track watchlist alerts (optional)

# One CHANNEL_<SPORT> per category (keys must match src/categories.js):
CHANNEL_SOCCER=https://discord.com/api/webhooks/REPLACE
CHANNEL_ESPORTS=https://discord.com/api/webhooks/REPLACE
CHANNEL_CRYPTO=https://discord.com/api/webhooks/REPLACE
CHANNEL_POLITICS=https://discord.com/api/webhooks/REPLACE
CHANNEL_BASKETBALL=https://discord.com/api/webhooks/REPLACE
CHANNEL_BASEBALL=https://discord.com/api/webhooks/REPLACE

# Filters (optional)
MIN_BET_USD=100
WHALE_MIN_USD=5000
BUYS_ONLY=true
WATCHLIST_MIN_BET_USD=50   # watchlist skips buys-only/min-bet, but still ignores dust below this

# Daily PnL leaderboard (optional) — only posts if SUMMARY_WEBHOOK_URL is set.
SUMMARY_HOUR_UTC=12   # hour of day (UTC) to post the leaderboard

# Discord bot for /track, /untrack, /watchlist (optional) — KEEP TOKEN SECRET.
# Leave DISCORD_BOT_TOKEN unset to disable slash commands entirely.
DISCORD_BOT_TOKEN=REPLACE          # bot token from the Discord Developer Portal
DISCORD_GUILD_ID=REPLACE           # your server ID — registers commands instantly (omit for slow global)
TRACK_ALLOWED_USER_IDS=            # optional comma-separated Discord user IDs allowed to use the commands

# State (Railway: mount a volume at /data)
STATE_FILE=/data/state.json
WATCHLIST_FILE=/data/watchlist.json   # persist the /track watchlist on the same volume
