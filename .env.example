# Discord webhooks — KEEP SECRET. Set these in Railway → Variables (never commit real values).
DEFAULT_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE   # catch-all "other" channel
WHALE_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE     # whale alerts (>= $5000)

# One CHANNEL_<SPORT> per category (keys must match src/categories.js):
CHANNEL_SOCCER=https://discord.com/api/webhooks/REPLACE
CHANNEL_ESPORTS=https://discord.com/api/webhooks/REPLACE
CHANNEL_CRYPTO=https://discord.com/api/webhooks/REPLACE
CHANNEL_POLITICS=https://discord.com/api/webhooks/REPLACE
CHANNEL_BASKETBALL=https://discord.com/api/webhooks/REPLACE
CHANNEL_BASEBALL=https://discord.com/api/webhooks/REPLACE

# Filters (optional)
MIN_BET_USD=100
WHALE_MIN_USD=5000
BUYS_ONLY=true

# State (Railway: mount a volume at /data)
STATE_FILE=/data/state.json
