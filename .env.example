# Copy to .env for local runs, or set these as variables in Railway.
# Everything here is optional if you put values in wallets.json instead.

# Fallback webhook used for any wallet that doesn't set its own webhookUrl.
DEFAULT_WEBHOOK_URL=

# How often to check each wallet, in milliseconds (default 15000 = 15s).
POLL_INTERVAL_MS=15000

# Set to "true" to post a wallet's existing recent trades the first time it's
# seen. Default false = only alert on trades that happen after startup.
POST_HISTORICAL_ON_START=false

# Path to the wallets file (default ./wallets.json).
# WALLETS_FILE=./wallets.json

# Where to persist seen-trade state (default ./.state.json).
# On Railway, point this at a mounted volume to survive redeploys, e.g. /data/state.json
# STATE_FILE=/data/state.json
